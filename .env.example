# --- Images (main branch: pulled from GitHub Packages / ghcr.io) ---
GHCR_OWNER=smart-home-ia-sample   # GitHub org/user that owns the ghcr.io/*/sh-* packages
SH_TAG=latest                     # or a pinned commit sha

# --- LLM (orchestrator + agents) ---
# mock (deterministic, default in CI) | google (Gemini) | ollama (local)
LLM_PROVIDER=mock
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_API_KEY=

# --- BFF (edge gateway + auth + persistence) ---
# The published image already bakes the SPA in (built from sh-frontend). For a
# custom build see docker-compose.build.yml (FRONT_SOURCE=git|local|none).
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
DEMO_USER=demo
# DEMO_PASS: plaintext used by orchestrator/MCP self-login on token-less entry
# points (/converse, startup). The BFF verifies against DEMO_PASS_HASH (bcrypt);
# unset -> the BFF's built-in dev hash for "demo". Keep them in sync.
DEMO_PASS=demo
# DEMO_PASS_HASH=

# Database. Unset -> embedded H2 file (single instance). Set all three for an
# external Postgres (stateless/replicated BFF):
# DB_URL=jdbc:postgresql://db:5432/smarthome
# DB_USERNAME=smarthome
# DB_PASSWORD=smarthome

# --- MQTT (simulated physical layer) ---
MQTT_USERNAME=smarthome
MQTT_PASSWORD=smarthome
SIM_EVENTS_ENABLED=true
SIM_EVENT_INTERVAL_SECONDS=20

LOG_LEVEL=INFO
